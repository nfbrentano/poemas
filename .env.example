# Firebase Configuration
VITE_FIREBASE_API_KEY="sua_api_key"
VITE_FIREBASE_AUTH_DOMAIN="poemas-natanael.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="poemas-natanael"
VITE_FIREBASE_STORAGE_BUCKET="poemas-natanael.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="seu_messaging_sender_id"
VITE_FIREBASE_APP_ID="seu_app_id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Web Push Notifications (VAPID)
# Gerada em: Firebase Console > Configurações do Projeto > Cloud Messaging > Web Push certificates
# Guia detalhado em docs/notificacoes-push-vapid.md
VITE_VAPID_PUBLIC_KEY="sua_chave_publica_vapid"

# E-mail Diário (GitHub Actions Secrets)
GMAIL_USER="seu_email@gmail.com"
GMAIL_PASS="sua_senha_de_app"
