{
  "name": "sitepoemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node --env-file=.env.local scripts/generate-sitemap.js || node scripts/generate-sitemap.js",
    "rss": "node --env-file=.env.local scripts/generate-rss.js || node scripts/generate-rss.js",
    "llms": "node --env-file=.env.local scripts/generate-llms.js || node scripts/generate-llms.js",
    "export:wxr": "node --env-file=.env.local scripts/export-wordpress-xml.js",
    "publish:scheduled": "node --env-file=.env.local scripts/publish-scheduled-poems.js || node scripts/publish-scheduled-poems.js",
    "redirects": "node scripts/build-legacy-redirects.js",
    "migrate:updated-at": "node --env-file=.env.local scripts/migrate-updated-at.js",
    "build": "vite build && npm run sitemap && npm run rss && npm run llms && (node --env-file=.env.local scripts/prerender.js || node scripts/prerender.js)",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint src scripts functions",
    "preview": "vite preview",
    "test": "vitest"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "fast-xml-parser": "^5.12.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@zumer/snapdom": "^3.7.0",
    "dotenv": "^18.0.9",
    "firebase": "^13.2.0",
    "nodemailer": "^10.3.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "fflate": "^0.8.3"
  }
}
