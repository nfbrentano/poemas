rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura pública de poemas e coleções (necessário para o site funcionar)
    match /poems/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /collections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /collection_poems/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Comentários: qualquer um pode ler e criar, mas só admin pode editar/deletar
    match /poem_comments/{document=**} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Reações aos poemas: leitura, criação e remoção públicas (baseadas em sessionId)
    match /poem_reactions/{document=**} {
      allow read, create, delete: if true;
      allow update: if request.auth != null;
    }

    // Notificações push
    match /push_subscriptions/{document=**} {
      allow read, create, delete: if true;
      allow update: if request.auth != null;
    }
    
    // Page views e Inscritos: qualquer um pode criar, só admin pode ler/editar
    match /page_views/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /subscribers/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Permite que a página "Sobre" leia a biografia e a foto
    match /site_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra geral para outras coleções (ex: emails, analytics, etc)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
