# Assets with cache-busting hashes or immutable fonts/icons
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker and web manifests must always revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# RSS feeds and sitemaps
/feed.xml
  Cache-Control: public, max-age=3600, must-revalidate

/sitemap*.xml
  Cache-Control: public, max-age=3600, must-revalidate

# HTML pages and dynamic documents
/*
  Cache-Control: public, max-age=0, must-revalidate
